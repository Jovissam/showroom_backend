# Jovisco API settings. Copy to .env and fill in real values (.env is git-ignored).
# Every setting can also come from a real environment variable, which takes precedence.

APP_TIMEZONE=Africa/Lagos

# Comma-separated origins allowed to call the API from a browser (the Nuxt site).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DB_HOST=localhost
DB_NAME=jovisco
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Signs admin session tokens: 64+ random characters, e.g.
#   php -r "echo bin2hex(random_bytes(32));"
# Changing it signs every admin out. REQUIRED.
JWT_SECRET=

# Public base URL of this API (no trailing slash). UPLOADS_URL defaults to API_URL/uploads.
API_URL=http://localhost/jovisco
UPLOADS_URL=

# Largest accepted image upload, in MB (PHP upload_max_filesize/post_max_size must allow it).
PORTFOLIO_MAX_UPLOAD_MB=10

SITE_NAME=Jovisco
FRONTEND_URL=http://localhost:3000
